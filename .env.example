# ── POS terminal (.env.pos) ─────────────────────────────────────────────────
# Baked into the installer at build time and extractable: never put secrets here.
# Licensing server (posgro). Only honoured when the app is NOT packaged; packaged
# builds always use the compiled-in production URL.
POSCLINIC_API_URL=https://api.posgro.uz/api

# ── Legacy posclinic server (frozen: clinics are now managed in posgro) ──────
DATABASE_URL="postgresql://postgres:password@localhost:5432/posclinic_db"
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me
CORS=*
