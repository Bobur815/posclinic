{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run prisma:generate*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prettier*)",
      "Bash(npx biome*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx cross-env APP_MODE=pos electron-vite build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "WebFetch(domain:www.electronjs.org)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:react.i18next.com)",
      "WebFetch(domain:styled-components.com)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm version*)",
      "Bash(npm run build:pos*)",
      "Bash(npm run prisma:migrate*)",
      "Bash(npm run prisma:push*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Edit(/electron-builder.config.js)"
    ],
    "deny": [
      "Edit(/src/generated/**)",
      "Edit(/package-lock.json)",
      "Read(./.env)",
      "Read(./.env.pos)",
      "Read(./.env.server)",
      "Read(./.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "PowerShell(Remove-Item*-Recurse*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ts\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-version-check.ts\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
