{
  "name": "posclinic",
  "version": "2.8.0",
  "description": "Parasitology clinic POS - offline-first, licensed by posgro",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:pos": "cross-env APP_MODE=pos electron-vite dev",
    "dev:pos:extra": "cross-env NODE_ENV=development electron .",
    "dev:pos:reception": "cross-env NODE_ENV=development POSCLINIC_PROFILE=reception electron .",
    "dev:pos:doctor": "cross-env NODE_ENV=development POSCLINIC_PROFILE=doctor electron .",
    "dev:pos:nurse": "cross-env NODE_ENV=development POSCLINIC_PROFILE=nurse electron .",
    "dev:pos:admin": "cross-env NODE_ENV=development POSCLINIC_PROFILE=admin electron .",
    "dev:fake-vcr": "tsx scripts/fake-vcr.ts",
    "dev:server": "nest start --watch",
    "build:pos": "cross-env APP_MODE=pos electron-vite build && electron-builder --config electron-builder.config.js",
    "build:server": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "cross-env SQLITE_DATABASE_URL=file:./dev.db prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "prisma:studio": "prisma studio",
    "prisma:studio:sqlite": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dist:win": "npm run prisma:generate:sqlite && cross-env APP_MODE=pos electron-vite build && electron-builder --config electron-builder.config.js --win --publish never",
    "deploy:pos": "npm run check && npm run dist:win && node scripts/upload-release.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "i18next": "^23.0.0",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.0.0",
    "recharts": "^3.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "styled-components": "^6.0.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@nestjs/cli": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^7.0.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "author": "Bobur",
  "license": "UNLICENSED"
}
