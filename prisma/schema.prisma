generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum ClinicType {
  GENERAL
  DENTAL
  OPHTHALMOLOGY
  PEDIATRIC
  ORTHOPEDIC
  DERMATOLOGY
  CARDIOLOGY
  NEUROLOGY
  OTHER
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
}

// ==================== CLINIC ====================

model Clinic {
  id          String      @id @default(cuid())
  name        String
  type        ClinicType  @default(GENERAL)
  address     String?
  phone       String?
  email       String?
  licenseNo   String?     @map("license_no")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  users        User[]
  patients     Patient[]
  doctors      Doctor[]
  services     Service[]
  appointments Appointment[]
  settings     ClinicSetting[]
  auditLogs    AuditLog[]
  heartbeats   TerminalHeartbeat[]

  @@map("clinics")
}

// ==================== USERS ====================

model User {
  id        String    @id @default(cuid())
  clinicId  String    @map("clinic_id")
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  fullName  String    @map("full_name")
  phone     String    @unique
  password  String
  role      UserRole  @default(RECEPTIONIST)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sessions  UserSession[]
  auditLogs AuditLog[]

  @@index([clinicId])
  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @map("refresh_token")
  deviceName   String?  @map("device_name")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

// ==================== PATIENTS ====================

model Patient {
  id           String    @id @default(cuid())
  clinicId     String    @map("clinic_id")
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  patientCode  String    @map("patient_code")
  fullName     String    @map("full_name")
  phone        String
  birthDate    DateTime? @map("birth_date")
  gender       Gender?
  bloodType    String?   @map("blood_type")
  allergies    String?
  address      String?
  city         String?
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  appointments Appointment[]

  @@unique([clinicId, patientCode])
  @@unique([clinicId, phone])
  @@index([clinicId])
  @@map("patients")
}

// ==================== DOCTORS ====================

model Doctor {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  fullName    String   @map("full_name")
  phone       String?
  specialty   String?
  licenseNo   String?  @map("license_no")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([clinicId])
  @@map("doctors")
}

// ==================== SERVICES ====================

model Service {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  code        String
  name        String
  description String?
  price       Decimal
  duration    Int      @default(30) // minutes
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appointmentItems AppointmentItem[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("services")
}

// ==================== APPOINTMENTS ====================

model Appointment {
  id               String            @id @default(cuid())
  clinicId         String            @map("clinic_id")
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  appointmentNumber String           @map("appointment_number")
  patientId        String            @map("patient_id")
  patient          Patient           @relation(fields: [patientId], references: [id])
  doctorId         String            @map("doctor_id")
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  appointmentDate  DateTime          @map("appointment_date")
  status           AppointmentStatus @default(SCHEDULED)
  totalAmount      Decimal           @default(0) @map("total_amount")
  paidAmount       Decimal           @default(0) @map("paid_amount")
  paymentStatus    PaymentStatus     @default(PENDING) @map("payment_status")
  paymentMethod    PaymentMethod?    @map("payment_method")
  diagnosis        String?
  prescription     String?
  notes            String?
  terminalId       String?           @map("terminal_id")
  synced           Boolean           @default(false)
  syncedAt         DateTime?         @map("synced_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  items   AppointmentItem[]
  payment Payment?

  @@unique([clinicId, appointmentNumber])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@map("appointments")
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String      @map("service_id")
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceName   String      @map("service_name")
  quantity      Int         @default(1)
  unitPrice     Decimal     @map("unit_price")
  total         Decimal

  @@index([appointmentId])
  @@map("appointment_items")
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique @map("appointment_id")
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Decimal
  method        PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

// ==================== CLINIC SETTINGS ====================

model ClinicSetting {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, key])
  @@map("clinic_settings")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clinicId])
  @@index([userId])
  @@map("audit_logs")
}

// ==================== TERMINAL HEARTBEAT ====================

model TerminalHeartbeat {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  terminalId  String   @map("terminal_id")
  lastSyncAt  DateTime @map("last_sync_at")
  unsyncedCount Int    @default(0) @map("unsynced_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([clinicId, terminalId])
  @@index([clinicId])
  @@map("terminal_heartbeats")
}
