// posclinic server (VPS) - PostgreSQL.
// The main till syncs its SQLite data up here; clinic admins read it and edit the catalog on the web.
// Contract: .claude/rules/server-api.md. Clinics and licences are owned by posgro: a clinic row is
// created from the first verified licence (Clinic.id = posgro storeId).
//
// Every business row carries clinicId and two clocks:
//   updatedAt - the writer's change time (till or web), compared for last-write-wins;
//   syncedAt  - set by the server on every write, the cursor for GET /sync/pull.
// Statuses and roles are plain strings, the same values the till stores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  /// posgro storeId
  id         String    @id
  name       String
  /// Copied from the last verified licence, display only.
  plan       String?
  expiresAt  DateTime? @map("expires_at")
  /// Licence blockAt; dashboard login is refused once it has passed.
  blockAt    DateTime? @map("block_at")
  lastSyncAt DateTime? @map("last_sync_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  users        User[]
  patients     Patient[]
  doctors      Doctor[]
  services     Service[]
  appointments Appointment[]
  auditLogs    AuditLog[]
  heartbeats   TerminalHeartbeat[]
  cases        ClinicalCase[]
  vitals       PatientVitals[]
  referrals    Referral[]
  results      AnalysisResult[]
  serviceTypes ServiceType[]
  staffTypes   StaffType[]
  products       Product[]
  stockReceipts  StockReceipt[]
  stockMovements StockMovement[]
  expenses       Expense[]
  payments       Payment[]

  @@map("clinics")
}

model User {
  id           String   @id
  clinicId     String   @map("clinic_id")
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  fullName     String   @map("full_name")
  /// +998XXXXXXXXX
  phone        String
  email        String?
  /// CLINIC_ADMIN | SUPER_ADMIN | DOCTOR | RECEPTIONIST
  role         String
  active       Boolean  @default(true)
  /// bcrypt; never plaintext
  passwordHash String   @map("password_hash")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")
  syncedAt     DateTime @map("synced_at")

  /// The till's custom staff type (till v2.5), a plain id.
  staffTypeId String? @map("staff_type_id")

  @@unique([clinicId, phone])
  @@index([clinicId, syncedAt])
  @@map("users")
}

model Patient {
  id                String    @id
  clinicId          String    @map("clinic_id")
  clinic            Clinic    @relation(fields: [clinicId], references: [id])
  patientCode       String    @map("patient_code")
  fullName          String    @map("full_name")
  phone             String
  birthDate         DateTime? @map("birth_date")
  gender            String?
  bloodType         String?   @map("blood_type")
  allergies         String?
  address           String?
  city              String?
  /// SOATO codes (the till's admin_units); `city` keeps the readable "District, Region".
  regionCode        String?   @map("region_code")
  districtCode      String?   @map("district_code")
  chronicConditions String?   @map("chronic_conditions")
  notes             String?
  active            Boolean   @default(true)
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  syncedAt          DateTime  @map("synced_at")

  appointments    Appointment[]
  cases           ClinicalCase[]
  vitals          PatientVitals[]
  referrals       Referral[]
  analysisResults AnalysisResult[]

  // Not unique here: the till owns uniqueness, and an in-flight rename on the till must not
  // fail a whole batch on the server.
  @@index([clinicId, syncedAt])
  @@index([clinicId, phone])
  @@index([clinicId, patientCode])
  @@index([clinicId, createdAt])
  @@map("patients")
}

model Doctor {
  id        String   @id
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  fullName  String   @map("full_name")
  phone     String?
  specialty String?
  licenseNo String?  @map("license_no")
  active    Boolean  @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  syncedAt  DateTime @map("synced_at")

  appointments Appointment[]

  @@index([clinicId, syncedAt])
  @@map("doctors")
}

model Service {
  id             String   @id
  clinicId       String   @map("clinic_id")
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  code           String
  name           String
  description    String?
  price          Decimal  @db.Decimal(14, 2)
  /// minutes
  duration       Int      @default(30)
  /// CONSULTATION | ANALYSIS | PROCEDURE | DIRECT_SALE
  kind           String   @default("PROCEDURE")
  /// The till's custom order type (till v2.5), a plain id.
  serviceTypeId  String?  @map("service_type_id")
  isFollowUp     Boolean  @default(false) @map("is_follow_up")
  /// ANALYSIS: QUALITATIVE | QUANTITATIVE | TEXT
  resultType     String?  @map("result_type")
  resultUnit     String?  @map("result_unit")
  referenceRange String?  @map("reference_range")
  /// Fiscal receipt codes from the till (v2.6): MXIK (IKPU, 17 digits) and its package code.
  mxik           String?
  packageCode    String?  @map("package_code")
  active         Boolean  @default(true)
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")
  syncedAt       DateTime @map("synced_at")

  appointmentItems AppointmentItem[]

  @@unique([clinicId, code])
  @@index([clinicId, syncedAt])
  @@map("services")
}

model Appointment {
  id                String   @id
  clinicId          String   @map("clinic_id")
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  appointmentNumber String   @map("appointment_number")
  patientId         String   @map("patient_id")
  patient           Patient  @relation(fields: [patientId], references: [id])
  /// The consultation's doctor; null for an analysis / procedure order (v2.5).
  doctorId          String?  @map("doctor_id")
  doctor            Doctor?  @relation(fields: [doctorId], references: [id])
  caseId            String?  @map("case_id")
  appointmentDate   DateTime @map("appointment_date")
  /// SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  status            String
  totalAmount       Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  paidAmount        Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// PENDING | PARTIAL | PAID
  paymentStatus     String   @map("payment_status")
  paymentMethod     String?  @map("payment_method")
  diagnosis         String?
  prescription      String?
  notes             String?
  terminalId        String?  @map("terminal_id")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")
  syncedAt          DateTime @map("synced_at")

  items AppointmentItem[]

  @@index([clinicId, syncedAt])
  @@index([clinicId, appointmentDate])
  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
  @@index([clinicId, caseId])
  @@map("appointments")
}

model AppointmentItem {
  id            String      @id
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String      @map("service_id")
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceName   String      @map("service_name")
  quantity      Int         @default(1)
  unitPrice     Decimal     @map("unit_price") @db.Decimal(14, 2)
  discount      Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  doctorId      String?     @map("doctor_id")
  referralId    String?     @map("referral_id")
  /// WAITING | IN_PROGRESS | DONE | CANCELLED
  status        String      @default("WAITING")
  performedBy   String?     @map("performed_by")
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")

  sessions TreatmentSession[]

  @@index([appointmentId])
  @@index([serviceId])
  @@map("appointment_items")
}

/// One session of a course line; replaced as a set with its item (like items with an appointment).
model TreatmentSession {
  id          String          @id
  itemId      String          @map("item_id")
  item        AppointmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  number      Int
  plannedDate DateTime?       @map("planned_date")
  doneAt      DateTime?       @map("done_at")
  doneBy      String?         @map("done_by")

  @@index([itemId])
  @@map("treatment_sessions")
}

/// One patient journey (till v2.5). References other than patient / clinic are plain ids.
model ClinicalCase {
  id         String    @id
  clinicId   String    @map("clinic_id")
  clinic     Clinic    @relation(fields: [clinicId], references: [id])
  caseNumber String    @map("case_number")
  patientId  String    @map("patient_id")
  patient    Patient   @relation(fields: [patientId], references: [id])
  doctorId   String?   @map("doctor_id")
  /// OPEN | WAITING_DOCTOR | WAITING_ANALYSIS | RESULT_READY | ON_TREATMENT | CLOSED
  status     String
  complaint  String?
  diagnosis  String?
  openedAt   DateTime  @map("opened_at")
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")
  syncedAt   DateTime  @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("clinical_cases")
}

model PatientVitals {
  id          String   @id
  clinicId    String   @map("clinic_id")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  patientId   String   @map("patient_id")
  patient     Patient  @relation(fields: [patientId], references: [id])
  caseId      String?  @map("case_id")
  heightCm    Decimal? @map("height_cm") @db.Decimal(6, 1)
  weightKg    Decimal? @map("weight_kg") @db.Decimal(6, 1)
  temperature Decimal? @db.Decimal(4, 1)
  bpSystolic  Int?     @map("bp_systolic")
  bpDiastolic Int?     @map("bp_diastolic")
  pregnant    Boolean?
  complaints  String?
  recordedBy  String?  @map("recorded_by")
  recordedAt  DateTime @map("recorded_at")
  updatedAt   DateTime @map("updated_at")
  syncedAt    DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, patientId])
  @@map("patient_vitals")
}

model Referral {
  id            String   @id
  clinicId      String   @map("clinic_id")
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  caseId        String   @map("case_id")
  patientId     String   @map("patient_id")
  patient       Patient  @relation(fields: [patientId], references: [id])
  doctorId      String?  @map("doctor_id")
  serviceId     String   @map("service_id")
  quantity      Int
  perDay        Int?     @map("per_day")
  days          Int?
  instructions  String?
  registeredQty Int      @default(0) @map("registered_qty")
  /// PENDING | PARTIAL | REGISTERED | CANCELLED
  status        String
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  syncedAt      DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, caseId])
  @@map("referrals")
}

model AnalysisResult {
  id            String    @id
  clinicId      String    @map("clinic_id")
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  itemId        String    @map("item_id")
  caseId        String?   @map("case_id")
  patientId     String    @map("patient_id")
  patient       Patient   @relation(fields: [patientId], references: [id])
  serviceId     String    @map("service_id")
  /// QUALITATIVE: POSITIVE | NEGATIVE
  outcome       String?
  value         Decimal?  @db.Decimal(18, 4)
  unit          String?
  finding       String?
  comment       String?
  sampleTakenAt DateTime? @map("sample_taken_at")
  enteredBy     String?   @map("entered_by")
  enteredAt     DateTime? @map("entered_at")
  confirmedBy   String?   @map("confirmed_by")
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  syncedAt      DateTime  @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, patientId])
  @@index([clinicId, caseId])
  @@map("analysis_results")
}

/// Web mutations by clinic admins (ids only, never patient fields).
model AuditLog {
  id        String   @id @default(uuid())
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  /// The admin who made the change (not a foreign key: users are synced rows).
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  /// JSON with changed field names / non-sensitive values.
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

model TerminalHeartbeat {
  clinicId   String   @map("clinic_id")
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  terminalId String   @map("terminal_id")
  lastSyncAt DateTime @map("last_sync_at")
  appVersion String?  @map("app_version")

  @@id([clinicId, terminalId])
  @@map("terminal_heartbeats")
}

/// The clinic's own order types (till Settings → Types), read-only on the web.
model ServiceType {
  id        String   @id
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  /// CONSULTATION | ANALYSIS | PROCEDURE | DIRECT_SALE
  behavior  String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  syncedAt  DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@map("service_types")
}

/// The clinic's own staff types (till Settings → Types), read-only on the web.
model StaffType {
  id        String   @id
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  /// NONE | RECEPTIONIST | NURSE | CLINIC_ADMIN
  access    String
  active    Boolean  @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  syncedAt  DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@map("staff_types")
}

// ==================== STOCK AND MONEY (till v2.10, read-only on the web) ====================

/// Anything the clinic buys and keeps. On hand and average cost come from the till.
model Product {
  id        String   @id
  clinicId  String   @map("clinic_id")
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  /// SALE | TREATMENT | HOUSEHOLD
  category  String
  unit      String
  barcode   String?
  minQty    Decimal? @map("min_qty") @db.Decimal(14, 3)
  qtyOnHand Decimal  @default(0) @map("qty_on_hand") @db.Decimal(14, 3)
  avgCost   Decimal  @default(0) @map("avg_cost") @db.Decimal(14, 4)
  /// The DIRECT_SALE service that sells it (plain id).
  serviceId String?  @map("service_id")
  active    Boolean  @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  syncedAt  DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, category])
  @@map("products")
}

/// A delivery from a supplier (its lines are IN movements).
model StockReceipt {
  id          String    @id
  clinicId    String    @map("clinic_id")
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  number      String
  supplier    String?
  docNo       String?   @map("doc_no")
  receivedAt  DateTime  @map("received_at")
  total       Decimal   @db.Decimal(14, 2)
  /// DRAWER | OUTSIDE
  paidFrom    String    @map("paid_from")
  note        String    @default("")
  createdById String?   @map("created_by_id")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  syncedAt    DateTime  @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, receivedAt])
  @@map("stock_receipts")
}

/// Every change of stock (never edited on the till).
model StockMovement {
  id          String   @id
  clinicId    String   @map("clinic_id")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  /// The product (plain id: a movement may arrive before its product, sync never drops it).
  productId   String   @map("product_id")
  /// IN | SALE | TREATMENT | HOUSEHOLD | ADJUST | VOID
  type        String
  qty         Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 4)
  receiptId   String?  @map("receipt_id")
  itemId      String?  @map("item_id")
  sessionId   String?  @map("session_id")
  note        String   @default("")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  syncedAt    DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

/// Money spent that is not stock.
model Expense {
  id          String    @id
  clinicId    String    @map("clinic_id")
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  /// RENT | SALARY | UTILITIES | REPAIR | TAX | OTHER
  category    String
  amount      Decimal   @db.Decimal(14, 2)
  spentAt     DateTime  @map("spent_at")
  note        String    @default("")
  /// DRAWER | OUTSIDE
  paidFrom    String    @map("paid_from")
  createdById String?   @map("created_by_id")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  syncedAt    DateTime  @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, spentAt])
  @@map("expenses")
}

/// One payment taken on a visit (till v2.6 rows; synced from till v2.10). Never changed. The visit
/// is a plain id: a payment may arrive before its visit, sync never drops it.
model Payment {
  id            String   @id
  clinicId      String   @map("clinic_id")
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  /// The visit (plain id).
  appointmentId String   @map("appointment_id")
  /// CASH | CARD | TRANSFER | INSURANCE
  method        String
  amount        Decimal  @db.Decimal(14, 2)
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  syncedAt      DateTime @map("synced_at")

  @@index([clinicId, syncedAt])
  @@index([clinicId, createdAt])
  @@index([appointmentId])
  @@map("payments")
}
