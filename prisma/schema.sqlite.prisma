// POSCLINIC - SQLite Schema for Electron POS Terminal
// This schema is for local offline-first operation
// Data syncs with the PostgreSQL server

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

// ==================== LOCAL CONFIG ====================

model LocalConfig {
  id         String   @id @default("config")
  clinicId   String   @map("clinic_id")
  clinicName String   @map("clinic_name")
  terminalId String   @map("terminal_id")
  apiUrl     String   @map("api_url")
  lastSync   DateTime @default(now()) @map("last_sync")

  @@map("local_config")
}

// ==================== CLOUD SYNC ====================

/// One row per synced entity (patients, doctors, services, users, appointments).
/// push_cursor = "<updatedAt ISO>|<id>" of the last row the server accepted;
/// pull_cursor = the server's serverTime of the last pull. src/main/sync/sync-service.ts
model SyncState {
  entity     String    @id
  pushCursor String?   @map("push_cursor")
  pullCursor String?   @map("pull_cursor")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("sync_state")
}

// ==================== USERS ====================

model User {
  id        String   @id @default(cuid())
  /// Login identity, `+998XXXXXXXXX` (src/shared/phone.ts)
  phone     String   @unique
  email     String?
  password  String
  role      String   @default("RECEPTIONIST")
  fullName  String   @map("full_name")
  active    Boolean  @default(true)
  clinicId  String?  @map("clinic_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Custom staff type (cleaner, accountant…); its access decides `role`. Null = a built-in role.
  staffTypeId String?    @map("staff_type_id")
  staffType   StaffType? @relation(fields: [staffTypeId], references: [id])

  doctor Doctor?

  shiftsOpened   Shift[]        @relation("ShiftOpenedBy")
  shiftsClosed   Shift[]        @relation("ShiftClosedBy")
  cashMovements  CashMovement[]
  paymentsTaken  Payment[]

  @@index([clinicId])
  @@map("users")
}

// ==================== PATIENTS ====================

model Patient {
  id                String     @id @default(cuid())
  patientCode       String     @unique @map("patient_code")
  fullName          String     @map("full_name")
  phone             String     @unique
  birthDate         DateTime?  @map("birth_date")
  gender            String?
  bloodType         String?    @map("blood_type")
  allergies         String?
  /// Street / house, free text (the administrative part is regionCode + districtCode).
  address           String?
  /// Display text kept for the server/web (which have no address dataset): "District, Region".
  city              String?
  /// SOATO code of the region / republic / Tashkent City (admin_units, level 1).
  regionCode        String?    @map("region_code")
  region            AdminUnit? @relation("PatientRegion", fields: [regionCode], references: [code])
  /// SOATO code of the district / city inside regionCode (admin_units, level 2).
  districtCode      String?    @map("district_code")
  district          AdminUnit? @relation("PatientDistrict", fields: [districtCode], references: [code])
  /// Chronic illnesses, free text (doctor-editable, like allergies).
  chronicConditions String?    @map("chronic_conditions")
  notes             String?
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  appointments    Appointment[]
  cases           ClinicalCase[]
  vitals          PatientVitals[]
  referrals       Referral[]
  analysisResults AnalysisResult[]

  @@index([regionCode])
  @@index([districtCode])
  @@map("patients")
}

// ==================== ADDRESSES (Uzbekistan, SOATO) ====================

/// Uzbekistan administrative units from the official SOATO classifier, bundled with the till
/// (src/main/database/data/admin-units.json) and imported idempotently on start
/// (src/main/database/admin-units.ts). Level 1: REGION | REPUBLIC | CITY (Tashkent);
/// level 2: DISTRICT | CITY, parentCode = its level-1 unit. Never deleted: a unit dropped from
/// the dataset becomes inactive, so patients that reference it keep their address.
model AdminUnit {
  code       String      @id
  parentCode String?     @map("parent_code")
  parent     AdminUnit?  @relation("AdminUnitTree", fields: [parentCode], references: [code])
  children   AdminUnit[] @relation("AdminUnitTree")
  type       String
  level      Int
  nameUz     String      @map("name_uz")
  nameUzCyrl String?     @map("name_uz_cyrl")
  nameRu     String?     @map("name_ru")
  nameEn     String?     @map("name_en")
  active     Boolean     @default(true)
  updatedAt  DateTime    @default(now()) @map("updated_at")

  regionPatients   Patient[] @relation("PatientRegion")
  districtPatients Patient[] @relation("PatientDistrict")

  @@index([parentCode, active])
  @@index([level, active])
  @@map("admin_units")
}

// ==================== DOCTORS ====================

model Doctor {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name")
  phone     String?
  specialty String?
  licenseNo String?  @map("license_no")
  /// The doctor's till login (role DOCTOR); null = no login yet.
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  items        AppointmentItem[]
  cases        ClinicalCase[]
  referrals    Referral[]

  @@map("doctors")
}

// ==================== SERVICES ====================

model Service {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  price          Decimal
  duration       Int      @default(30)
  /// The behaviour: CONSULTATION (needs a doctor) | ANALYSIS (has a result) | PROCEDURE (can be
  /// a course) | DIRECT_SALE (done at payment). With a serviceType it is that type's behaviour.
  kind           String   @default("PROCEDURE")
  /// Repeat consultation: free within `followUpFreeDays` of a paid consultation in the case.
  isFollowUp     Boolean  @default(false) @map("is_follow_up")
  /// ANALYSIS only: QUALITATIVE | QUANTITATIVE | TEXT
  resultType     String?  @map("result_type")
  resultUnit     String?  @map("result_unit")
  referenceRange String?  @map("reference_range")
  /// Picture for the till only (v2.5): a data URL (PNG / JPEG / WebP, ≤ 256 px, resized on the
  /// till). Never synced to the server; the web dashboard does not show it.
  image          String?
  /// Fiscal receipt (v2.6): MXIK (IKPU, 17 digits, tasnif.soliq.uz) and its package code. Null =
  /// the Settings → Fiscal receipt default for the service's kind.
  mxik           String?
  packageCode    String?  @map("package_code")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  /// Custom order type (e.g. "Drugs and ointments"); null = shown by its kind.
  serviceTypeId String?      @map("service_type_id")
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  appointmentItems AppointmentItem[]
  referrals        Referral[]
  analysisResults  AnalysisResult[]

  @@map("services")
}

// ==================== CASES (one patient journey) ====================

model ClinicalCase {
  id         String    @id @default(cuid())
  caseNumber String    @unique @map("case_number")
  patientId  String    @map("patient_id")
  patient    Patient   @relation(fields: [patientId], references: [id])
  /// Lead doctor; null for a walk-in analysis.
  doctorId   String?   @map("doctor_id")
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])
  /// OPEN | WAITING_DOCTOR | WAITING_ANALYSIS | RESULT_READY | ON_TREATMENT | CLOSED
  status     String    @default("OPEN")
  complaint  String?
  diagnosis  String?
  openedAt   DateTime  @default(now()) @map("opened_at")
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  appointments    Appointment[]
  vitals          PatientVitals[]
  referrals       Referral[]
  analysisResults AnalysisResult[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@map("clinical_cases")
}

// ==================== APPOINTMENTS (paid orders) ====================

model Appointment {
  id                String        @id @default(cuid())
  appointmentNumber String        @unique @map("appointment_number")
  patientId         String        @map("patient_id")
  patient           Patient       @relation(fields: [patientId], references: [id])
  /// Doctor of the consultation in this order; null for analysis / procedure orders.
  doctorId          String?       @map("doctor_id")
  doctor            Doctor?       @relation(fields: [doctorId], references: [id])
  caseId            String?       @map("case_id")
  case              ClinicalCase? @relation(fields: [caseId], references: [id])
  appointmentDate   DateTime      @map("appointment_date")
  status            String        @default("SCHEDULED")
  totalAmount       Decimal       @default(0) @map("total_amount")
  /// Sum of item discounts (already taken off totalAmount).
  discountAmount    Decimal       @default(0) @map("discount_amount")
  paidAmount        Decimal       @default(0) @map("paid_amount")
  paymentStatus     String        @default("PENDING") @map("payment_status")
  paymentMethod     String?       @map("payment_method")
  diagnosis         String?
  prescription      String?
  notes             String?
  terminalId        String?       @map("terminal_id")
  synced            Boolean       @default(false)
  syncedAt          DateTime?     @map("synced_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  items    AppointmentItem[]
  payments Payment[]

  @@index([patientId])
  @@index([doctorId])
  @@index([caseId])
  @@index([appointmentDate])
  @@index([synced])
  @@map("appointments")
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String      @map("service_id")
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceName   String      @map("service_name")
  quantity      Int         @default(1)
  unitPrice     Decimal     @map("unit_price")
  /// Discount on this line (a full course paid upfront); `total` is after it.
  discount      Decimal     @default(0)
  total         Decimal
  /// Consultation lines: whose queue it is in.
  doctorId      String?     @map("doctor_id")
  doctor        Doctor?     @relation(fields: [doctorId], references: [id])
  /// The doctor's referral this line was registered from.
  referralId    String?     @map("referral_id")
  referral      Referral?   @relation(fields: [referralId], references: [id])
  /// Queue state: WAITING | IN_PROGRESS | DONE | CANCELLED
  status        String      @default("WAITING")
  /// User (doctor / nurse) who took or finished it.
  performedBy   String?     @map("performed_by")
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")

  results  AnalysisResult[]
  sessions TreatmentSession[]

  @@index([appointmentId])
  @@index([doctorId, status])
  @@index([status])
  @@map("appointment_items")
}

// ==================== CLINICAL RECORDS ====================

/// One measurement per visit; the latest is the patient's current height / weight.
model PatientVitals {
  id          String        @id @default(cuid())
  patientId   String        @map("patient_id")
  patient     Patient       @relation(fields: [patientId], references: [id])
  caseId      String?       @map("case_id")
  case        ClinicalCase? @relation(fields: [caseId], references: [id])
  heightCm    Decimal?      @map("height_cm")
  weightKg    Decimal?      @map("weight_kg")
  temperature Decimal?
  bpSystolic  Int?          @map("bp_systolic")
  bpDiastolic Int?          @map("bp_diastolic")
  pregnant    Boolean?
  complaints  String?
  recordedBy  String?       @map("recorded_by")
  recordedAt  DateTime      @default(now()) @map("recorded_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([patientId, recordedAt])
  @@map("patient_vitals")
}

/// A doctor's order for reception: "send to analysis X" or "course Y, 2 a day for 5 days".
model Referral {
  id            String       @id @default(cuid())
  caseId        String       @map("case_id")
  case          ClinicalCase @relation(fields: [caseId], references: [id])
  patientId     String       @map("patient_id")
  patient       Patient      @relation(fields: [patientId], references: [id])
  doctorId      String?      @map("doctor_id")
  doctor        Doctor?      @relation(fields: [doctorId], references: [id])
  serviceId     String       @map("service_id")
  service       Service      @relation(fields: [serviceId], references: [id])
  /// Total sessions / units (perDay × days for a course).
  quantity      Int          @default(1)
  perDay        Int?         @map("per_day")
  days          Int?
  instructions  String?
  /// How many of `quantity` reception has registered so far.
  registeredQty Int          @default(0) @map("registered_qty")
  /// PENDING | PARTIAL | REGISTERED | CANCELLED
  status        String       @default("PENDING")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  items AppointmentItem[]

  @@index([patientId, status])
  @@index([caseId])
  @@map("referrals")
}

model AnalysisResult {
  id            String          @id @default(cuid())
  itemId        String          @map("item_id")
  item          AppointmentItem @relation(fields: [itemId], references: [id])
  caseId        String?         @map("case_id")
  case          ClinicalCase?   @relation(fields: [caseId], references: [id])
  patientId     String          @map("patient_id")
  patient       Patient         @relation(fields: [patientId], references: [id])
  serviceId     String          @map("service_id")
  service       Service         @relation(fields: [serviceId], references: [id])
  /// QUALITATIVE: POSITIVE | NEGATIVE
  outcome       String?
  value         Decimal?
  unit          String?
  /// e.g. which parasite was found
  finding       String?
  comment       String?
  sampleTakenAt DateTime?       @map("sample_taken_at")
  enteredBy     String?         @map("entered_by")
  enteredAt     DateTime?       @map("entered_at")
  confirmedBy   String?         @map("confirmed_by")
  confirmedAt   DateTime?       @map("confirmed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([caseId])
  @@index([itemId])
  @@map("analysis_results")
}

/// One session of a course line ("3 of 10"), ticked off by the nurse.
model TreatmentSession {
  id          String          @id @default(cuid())
  itemId      String          @map("item_id")
  item        AppointmentItem @relation(fields: [itemId], references: [id])
  number      Int
  plannedDate DateTime?       @map("planned_date")
  doneAt      DateTime?       @map("done_at")
  doneBy      String?         @map("done_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([itemId, number])
  @@index([plannedDate, doneAt])
  @@map("treatment_sessions")
}

// ==================== SYNC QUEUE ====================

model SyncQueue {
  id        String   @id @default(cuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  payload   String
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity])
  @@map("sync_queue")
}

// ==================== LAN (satellite tills) ====================

/// Key/value settings of this till (JSON values): lan_role, lan_enabled, lan_port, lan_link,
/// lan_lineage, auth_secret. src/main/lan/config.ts
model Setting {
  key       String    @id
  value     String
  updatedAt DateTime? @default(now()) @map("updated_at")

  @@map("settings")
}

/// Satellite tills paired with this main till. Only a SHA-256 of the device secret is kept.
/// src/main/lan/devices.ts
model LanDevice {
  id         String    @id
  name       String
  secretHash String    @map("secret_hash")
  ip         String?
  lastSeenAt DateTime? @map("last_seen_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("lan_devices")
}

// ==================== CUSTOM TYPES (admin Settings → Types) ====================

/// An order type the clinic adds: a name, a colour and one of the fixed behaviours.
model ServiceType {
  id        String   @id @default(cuid())
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  /// CONSULTATION | ANALYSIS | PROCEDURE | DIRECT_SALE
  behavior  String
  /// #rrggbb for the badge
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_types")
}

/// A staff type the clinic adds (cleaner, guard, accountant…) and what it may do on the till.
model StaffType {
  id        String   @id @default(cuid())
  nameUz    String   @map("name_uz")
  nameRu    String?  @map("name_ru")
  /// NONE (no login) | RECEPTIONIST | NURSE | CLINIC_ADMIN
  access    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("staff_types")
}

// ==================== SHIFTS (v2.6) ====================

/// A cash shift (SavdoChef's "smena"): every payment is taken inside the one open shift. The
/// drawer is counted at open and at close; the expected cash is frozen at close.
model Shift {
  id           String    @id @default(cuid())
  /// OPEN | CLOSED
  status       String    @default("OPEN")
  /// 1 while open, NULL once closed. UNIQUE, so the database itself allows one open shift
  /// (SQLite treats NULLs as distinct). Written by shifts.ts only.
  openGuard    Int?      @unique @map("open_guard")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openedById   String?   @map("opened_by_id")
  openedBy     User?     @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedById   String?   @map("closed_by_id")
  closedBy     User?     @relation("ShiftClosedBy", fields: [closedById], references: [id])
  openingCash  Decimal   @default(0) @map("opening_cash")
  countedCash  Decimal?  @map("counted_cash")
  expectedCash Decimal?  @map("expected_cash")
  /// REGOS:VCR's Z-report opened for this shift, and when VCR closed it (v2.6 fiscal).
  fiscalZReportId Int?      @map("fiscal_z_report_id")
  fiscalZClosedAt DateTime? @map("fiscal_z_closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  payments      Payment[]
  cashMovements CashMovement[]

  @@index([status])
  @@map("shifts")
}

/// Cash put in or taken out of the open shift's drawer. Never edited or deleted: a mistake is
/// undone with the opposite movement.
model CashMovement {
  id          String   @id @default(cuid())
  shiftId     String   @map("shift_id")
  shift       Shift    @relation(fields: [shiftId], references: [id])
  /// PAY_IN | PAY_OUT
  type        String
  amount      Decimal
  note        String   @default("")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shiftId])
  @@map("cash_movements")
}

/// One payment on a visit (v2.6): the money actually kept (change is not), its method and shift.
/// `appointments.paid_amount` stays the running total. Visits paid before v2.6 have no rows.
model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  shiftId       String      @map("shift_id")
  shift         Shift       @relation(fields: [shiftId], references: [id])
  /// CASH | CARD | TRANSFER | INSURANCE
  method        String
  amount        Decimal
  createdById   String?     @map("created_by_id")
  createdBy     User?       @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@index([shiftId])
  @@map("payments")
}
