{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../src/shared/*"],
      "@renderer/*": ["../../src/renderer/*"],
      "@components/common/*": ["../../src/renderer/components/common/*"],
      "@theme/*": ["../../src/renderer/theme/*"],
      "@context/*": ["../../src/renderer/context/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../src/renderer/components/common/**/*",
    "../../src/renderer/theme/**/*",
    "../../src/renderer/context/**/*",
    "../../src/shared/**/*"
  ],
  "exclude": ["../../src/**/*.test.ts", "../../src/**/*.test.tsx"]
}
